<Window x:Class="OpenNari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenNari"
        Title="OpenNari" Width="1020" Height="780" MinWidth="800" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#157A61" Geometry="M 2,2 L 30,2 30,30 2,30 Z"/>
                    <GeometryDrawing Brush="White" Geometry="M 8,25 L 8,7 12,7 21,18 21,7 25,7 25,25 21,25 12,14 12,25 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#18252A"/>
        <SolidColorBrush x:Key="Muted" Color="#647178"/>
        <SolidColorBrush x:Key="Accent" Color="#157A61"/>
        <local:ViewportWidthConverter x:Key="ViewportWidthConverter"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E9EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="26"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#106B55"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EDF2F1"/>
            <Setter Property="Foreground" Value="#1A5B4C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCEBE6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#18282D">
            <Grid Margin="24,30,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#1A9E7A" CornerRadius="8" Margin="0,0,11,0">
                        <TextBlock Text="N" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OpenNari" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#29443E" CornerRadius="8" Padding="12,11">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#63D8AB" Margin="0,0,11,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Device controls" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="#3A4A4E" Margin="0,0,0,17"/>
                    <TextBlock Text="LOCAL USB CONTROL" Foreground="#91AAA8" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="Your audio stays with Windows." Foreground="#BACBC9" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="SettingsGrid" Width="{Binding ElementName=SettingsScroll, Path=ViewportWidth, Converter={StaticResource ViewportWidthConverter}}" Margin="40,34,40,36" MaxWidth="760" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Nari Ultimate" Foreground="{StaticResource Ink}" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="A simple home for your headset settings." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="ConnectionText" Text="Looking for the receiver…" Foreground="{StaticResource Ink}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            <TextBlock x:Name="ConnectionDetail" Text="Checking the USB settings interface" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ReconnectButton" Grid.Column="1" Content="Reconnect" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="18,0,0,0" Click="Reconnect_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="HyperSense" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose how strongly the headset responds to sound." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EDF5F1" CornerRadius="10" Padding="12,7" VerticalAlignment="Top" Margin="15,0,0,0">
                                <TextBlock x:Name="HapticsStateText" Text="Not set" Foreground="#176B53" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Strength" Foreground="{StaticResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StrengthValueText" Grid.Column="1" Text="50%" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold"/>
                        </Grid>
                        <Slider x:Name="StrengthSlider" Minimum="20" Maximum="100" Value="50" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="StrengthSlider_ValueChanged"/>
                        <Grid Margin="0,2,0,0"><TextBlock Text="20%" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="100%" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
                            <Button x:Name="ApplyStrengthButton" Content="Apply strength" Style="{StaticResource PrimaryButton}" Click="ApplyStrength_Click"/>
                            <Button x:Name="HapticsOffButton" Content="Turn off" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="HapticsOff_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lighting" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Switch the earcup lights on or off." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock x:Name="LightingStateText" Text="Not set in this session" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="LightingOnButton" Content="Turn on" Style="{StaticResource PrimaryButton}" Click="LightingOn_Click"/>
                            <Button x:Name="LightingOffButton" Content="Turn off" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="LightingOff_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="8" Background="#EAF0F3" CornerRadius="12" Padding="18,14">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Ready to connect." Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Color and lighting effects need more USB captures. The app currently sends the documented lighting on/off command." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
