<Window x:Class="OpenNari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenNari" Width="540" Height="716" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackdrop}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#172D2A" Geometry="M 2,2 L 30,2 30,30 2,30 Z"/>
                    <GeometryDrawing Brush="#5CD3A5" Geometry="M 6,8 L 14,5 17,8 11,11 12,15 8,17 Z"/>
                    <GeometryDrawing Brush="#5CD3A5" Geometry="M 21,5 L 27,11 25,15 20,10 16,12 14,8 Z"/>
                    <GeometryDrawing Brush="#5CD3A5" Geometry="M 10,22 L 17,18 21,21 14,25 11,28 7,25 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#182C2B"/>
        <SolidColorBrush x:Key="Muted" Color="#647C79"/>
        <SolidColorBrush x:Key="Accent" Color="#137B64"/>
        <SolidColorBrush x:Key="WindowSurface" Color="#DAFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBorder" Color="#F5FFFFFF"/>
        <SolidColorBrush x:Key="CardSurface" Color="#EFFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#AFCBDCD8"/>
        <SolidColorBrush x:Key="QuietBackground" Color="#DDECE9"/>
        <SolidColorBrush x:Key="QuietForeground" Color="#24544C"/>
        <SolidColorBrush x:Key="InputSurface" Color="#EFFFFFFF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#B8D5D1"/>
        <SolidColorBrush x:Key="BatterySurface" Color="#E4F3EF"/>
        <SolidColorBrush x:Key="HeaderSurface" Color="#D9FFFFFF"/>
        <SolidColorBrush x:Key="ConnectionSurface" Color="#A9EAF4F1"/>
        <SolidColorBrush x:Key="FooterSurface" Color="#93FFFFFF"/>
        <SolidColorBrush x:Key="FooterBorder" Color="#D8FFFFFF"/>
        <SolidColorBrush x:Key="Separator" Color="#B3D9D9D6"/>
        <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D6EEE8" Offset="0"/>
            <GradientStop Color="#EDF4F3" Offset="0.52"/>
            <GradientStop Color="#D5E8F0" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource QuietBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource QuietForeground}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="17"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><DynamicResource ResourceKey="AppBackdrop"/></Grid.Background>
        <Border Margin="14" Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                CornerRadius="23" Padding="17">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OpenNari" Foreground="{DynamicResource Ink}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="NARI ULTIMATE  ·  CONTROL" Foreground="{DynamicResource Muted}" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource HeaderSurface}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
                            CornerRadius="13" Padding="10,7" MinWidth="132" ToolTip="Approximate battery level; charging status comes from the receiver">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="27" Height="19" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border Width="23" Height="15" HorizontalAlignment="Left" CornerRadius="3"
                                        BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Background="{DynamicResource BatterySurface}"/>
                                <Border x:Name="BatteryFill" Width="0" Height="9" HorizontalAlignment="Left"
                                        Margin="3,0,0,0" Background="{DynamicResource Accent}" CornerRadius="1"/>
                                <Border Width="2" Height="6" HorizontalAlignment="Right" Background="{DynamicResource Accent}" CornerRadius="1"/>
                                <Path x:Name="ChargeBolt" Data="M 11,1 L 6,9 10,9 8,17 16,7 12,7 14,1 Z"
                                      Fill="#E6A933" Stroke="White" StrokeThickness="0.8" Visibility="Collapsed"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock x:Name="BatteryPercentText" Text="--%" Foreground="{DynamicResource Ink}"
                                           FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="ChargeStateText" Text="Battery unavailable"
                                           Foreground="{DynamicResource Muted}" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource ConnectionSurface}" BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="11,8" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#D59C42" Margin="0,0,9,0"/>
                            <StackPanel>
                                <TextBlock x:Name="ConnectionText" Text="Looking for receiver" Foreground="{DynamicResource Ink}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ConnectionDetail" Text="Checking USB interface" Style="{StaticResource BodyText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="ReconnectButton" Grid.Column="1" Content="Reconnect" Style="{StaticResource QuietButton}"
                                Click="Reconnect_Click" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,3,10">
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HyperSense" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="Fine-tune haptic feedback" Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StrengthValueText" Grid.Column="1" Text="50%" Foreground="{DynamicResource Accent}"
                                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="10"
                                        IsSnapToTickEnabled="True" ValueChanged="StrengthSlider_ValueChanged"/>
                                <Grid Margin="0,1,0,11">
                                    <TextBlock Text="0%" Style="{StaticResource BodyText}"/>
                                    <TextBlock Text="100%" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ApplyStrengthButton" Content="Apply strength" Style="{StaticResource ActionButton}" Click="ApplyStrength_Click"/>
                                    <Button x:Name="HapticsOffButton" Content="Turn off" Style="{StaticResource QuietButton}"
                                            Click="HapticsOff_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="HapticsStateText" Text="No haptic command sent in this session"
                                           Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="Lighting" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Set the earcup glow" Style="{StaticResource BodyText}" Margin="0,3,0,14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                    <Button x:Name="LightingOnButton" Content="Turn on" Style="{StaticResource ActionButton}" Click="LightingOn_Click"/>
                                    <Button x:Name="LightingOffButton" Content="Turn off" Style="{StaticResource QuietButton}"
                                            Click="LightingOff_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,13"/>
                                <TextBlock Text="STATIC COLOR" Foreground="{DynamicResource Muted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,7"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SelectedColorPreview" Width="28" Height="28" CornerRadius="8" Background="#00C878"
                                            BorderBrush="#80FFFFFF" BorderThickness="2" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBox x:Name="HexColorInput" Grid.Column="1" Text="#00C878" MaxLength="7"
                                             FontFamily="Consolas" FontSize="12" MinWidth="110"/>
                                    <Button x:Name="ApplyColorButton" Grid.Column="2" Content="Apply color" Style="{StaticResource ActionButton}"
                                            Click="ApplyColor_Click" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="LightingStateText" Text="No lighting command sent in this session"
                                           Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="3" Background="{DynamicResource FooterSurface}" BorderBrush="{DynamicResource FooterBorder}" BorderThickness="1"
                        CornerRadius="11" Padding="11,9" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Ready to connect." Foreground="{DynamicResource Ink}"
                                   FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="Version" Visibility="Collapsed" Foreground="{DynamicResource Muted}"
                                       FontSize="9" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <Button x:Name="ThemeToggleButton" Style="{StaticResource QuietButton}"
                                    Click="ThemeToggle_Click" Padding="10,6" MinHeight="30">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ThemeIconText" Text="☾" FontSize="13" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="ThemeButtonText" Text="Dark mode" FontSize="10"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
