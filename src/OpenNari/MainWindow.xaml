<Window x:Class="OpenNari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenNari" Width="1020" Height="790" MinWidth="780" MinHeight="670"
        WindowStartupLocation="CenterScreen" Background="#F2F4F5"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#172D2A" Geometry="M 2,2 L 30,2 30,30 2,30 Z"/>
                    <GeometryDrawing Brush="#5CD3A5" Geometry="M 6,8 L 14,5 17,8 11,11 12,15 8,17 Z"/>
                    <GeometryDrawing Brush="#5CD3A5" Geometry="M 21,5 L 27,11 25,15 20,10 16,12 14,8 Z"/>
                    <GeometryDrawing Brush="#5CD3A5" Geometry="M 10,22 L 17,18 21,21 14,25 11,28 7,25 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#19272B"/>
        <SolidColorBrush x:Key="Muted" Color="#657277"/>
        <SolidColorBrush x:Key="Accent" Color="#18765E"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#105F4B"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EDF1F1"/>
            <Setter Property="Foreground" Value="#27423B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCE7E4"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="36" MaxWidth="920" Background="White" BorderBrush="#E2E7E8"
                BorderThickness="1" CornerRadius="16" Padding="38,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" Background="#172D2A" CornerRadius="11" Margin="0,0,14,0">
                            <Viewbox Margin="7">
                                <Canvas Width="32" Height="32">
                                    <Path Fill="#5CD3A5" Data="M 6,8 L 14,5 17,8 11,11 12,15 8,17 Z"/>
                                    <Path Fill="#5CD3A5" Data="M 21,5 L 27,11 25,15 20,10 16,12 14,8 Z"/>
                                    <Path Fill="#5CD3A5" Data="M 10,22 L 17,18 21,21 14,25 11,28 7,25 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OpenNari" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="Razer Nari Ultimate" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Fill="#D59C42" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnectionText" Text="Looking for receiver" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="ConnectionDetail" Text="Checking USB interface" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="ReconnectButton" Content="Reconnect" Style="{StaticResource SecondaryButton}" Click="Reconnect_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#E7EBEC"/>

                <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="SettingsGrid" Margin="0,27,0,27">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="HyperSense" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Set the headset haptic response strength." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="StrengthValueText" Grid.Column="1" Text="50%" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="StrengthSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="50"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,5"
                                    ValueChanged="StrengthSlider_ValueChanged"/>
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <TextBlock Text="0%" Foreground="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock Text="100%" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="HapticsStateText" Grid.Row="3" Text="No haptic command sent in this session" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="ApplyStrengthButton" Content="Apply strength" Style="{StaticResource PrimaryButton}" Click="ApplyStrength_Click"/>
                            <Button x:Name="HapticsOffButton" Content="Turn off" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Click="HapticsOff_Click"/>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#E7EBEC" Margin="0,31,0,27"/>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Lighting" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Turn the earcup lights on or off." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="LightingOnButton" Content="Turn on" Style="{StaticResource PrimaryButton}" Click="LightingOn_Click"/>
                                    <Button x:Name="LightingOffButton" Content="Turn off" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="LightingOff_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LightingStateText" Grid.Row="1" Text="No lighting command sent in this session" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,17"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectedColorPreview" Width="22" Height="22" CornerRadius="5" Background="#00C878" BorderBrush="#D6DEDE" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="HexColorInput" Grid.Column="1" Text="#00C878" MaxLength="7" VerticalContentAlignment="Center"
                                         Padding="10,8" MinWidth="150" BorderBrush="#D5DDDF" BorderThickness="1" Background="White"
                                         Foreground="{StaticResource Ink}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Column="2" Text="HEX" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0,15,0"/>
                                <Button x:Name="ApplyColorButton" Grid.Column="3" Content="Apply color" Style="{StaticResource PrimaryButton}" Click="ApplyColor_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" Background="#F4F6F6" CornerRadius="8" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Ready to connect." Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="VersionText" Text="Version" Visibility="Collapsed" Foreground="{StaticResource Ink}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="Lighting effects are under research" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
